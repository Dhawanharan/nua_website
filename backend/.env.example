PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Supabase Credentials (Get these from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
# Use Service Role Key for backend administrative operations or Anon Key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Storage Bucket Name in Supabase Storage
SUPABASE_STORAGE_BUCKET=nua-photos
